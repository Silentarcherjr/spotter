{
  "name": "spotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "demo": "node scripts/dev.mjs --demo",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "calibrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/calibrate.ts",
    "obs:setup": "node --experimental-strip-types --env-file-if-exists=.env scripts/obs-setup.ts",
    "twitch:fixtures": "node --experimental-strip-types scripts/twitch-fixtures.ts",
    "twitch:proof": "node --experimental-strip-types --env-file-if-exists=.env scripts/twitch-proof.ts",
    "obs:proof": "node --experimental-strip-types --env-file-if-exists=.env scripts/obs-proof.ts",
    "twitch:markers": "node --experimental-strip-types --env-file-if-exists=.env scripts/marker-proof.ts",
    "crew:dev": "node --experimental-strip-types --env-file-if-exists=.env scripts/crew-dev.ts",
    "crew:link": "node --experimental-strip-types scripts/crew-link.ts",
    "obs:secondary": "node --experimental-strip-types --env-file-if-exists=.env scripts/obs-secondary.ts",
    "obs:hud-bridge": "node --experimental-strip-types --env-file-if-exists=.env scripts/obs-hud-bridge.ts",
    "crew:retire": "node --experimental-strip-types --env-file-if-exists=.env scripts/crew-retire.ts",
    "eval": "node --experimental-strip-types --env-file-if-exists=.env scripts/evaluate.ts",
    "bench:latency": "node --experimental-strip-types --env-file-if-exists=.env scripts/latency.ts",
    "qr:obs-probe": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-obs-probe.ts",
    "qr:fixtures": "node --experimental-strip-types scripts/qr-fixtures.ts",
    "qr:eval": "node --experimental-strip-types scripts/evaluate-qr.ts",
    "qr:benchmark": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-benchmark.ts",
    "qr:demo": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-demo.ts",
    "qr:proof-view": "node scripts/qr-proof-view.mjs",
    "qr:recorder": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-recorder.ts",
    "qr:setup": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-setup.ts",
    "qr:program-proof": "node --experimental-strip-types --env-file-if-exists=.env scripts/qr-program-proof.ts",
    "qr:analyze-take": "node --experimental-strip-types scripts/qr-analyze-take.ts",
    "golive:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/golive-check.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@zxing/library": "^0.23.0",
    "fastify": "^5.12.7",
    "obs-websocket-js": "^5.0.8",
    "pitchy": "^4.1.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
