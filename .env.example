PORT=3210
SIM=0
# Optional public channel display name used only by clearly labelled demo overlays.
SIM_DISPLAY_NAME="Demo host"
DATABASE_PATH=data/spotter.sqlite
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3210/api/twitch/callback
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
# npm run obs:setup configures these names for the local-video scene collection.
OBS_MAIN_SCENE=Main
OBS_PRIVACY_SCENE=Privacy
OBS_SOURCE=
OBS_OVERLAY_SOURCE=Spotter Overlay
OBS_PRIVACY_SOURCE=Spotter Privacy
OBS_BLUR_FILTER=
# Direct OpenAI (default); for OpenRouter use https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1
# Use the selected service's key here (OpenAI or OpenRouter).
OPENAI_API_KEY=
# OpenAI: model ID. OpenRouter: proveedor/modelo (exact model ID from OpenRouter).
# Choose a model supporting images and strict JSON Schema; no model is hard-coded.
OPENAI_MODEL=
OPENAI_VISION_DETAIL=high
VISION_FRAME_WIDTH=1280
AI_TIMEOUT_MS=15000
VISION_VIDEO_PATH=
SIM_FRAME_DIR=
CREW_FILE=
CREW_SHARED_SECRET=
EXPOSURE_WARN=60
EXPOSURE_ACT=80

# Combined alert: energy strictly below this value for >=30s, with available exposure >=60.
# Personal heuristic, not a clinical measurement.
ENERGY_ALERT_THRESHOLD=45

# Tag Out: personal heuristic, strictly below threshold; approval still required.
TAGOUT_ENERGY_THRESHOLD=45
TAGOUT_SUSTAIN_S=60

# Real OBS capture cadence: 4000 ms (default), or 2000 ms for twice the sampling opportunities.
VISION_CAPTURE_INTERVAL_MS=4000

# Default: private mod notice + ID-only audit. Explicit 1 enables automatic deletion.
CHAT_AUTO_DELETE=0
